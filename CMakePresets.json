{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "vs2022-debug",
      "displayName": "Visual Studio 2022 - Win32 Debug",
      "inherits": "vs2022",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/debug"
      }
    },
    {
      "name": "vs2022-release",
      "displayName": "Visual Studio 2022 - Win32 Release",
      "inherits": "vs2022",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    }
  ]
}

